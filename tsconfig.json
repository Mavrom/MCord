{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],

        "strict": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": false,
        "useUnknownInCatchVariables": false,

        "jsx": "react",
        "jsxFactory": "McordCreateElement",
        "jsxFragmentFactory": "McordFragment",

        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "noEmit": true,

        "baseUrl": "./src",
        "paths": {
            "@api": ["api/index.ts"],
            "@api/*": ["api/*"],
            "@components/*": ["components/*"],
            "@debug/*": ["debug/*"],
            "@main/*": ["main/*"],
            "@patcher": ["patcher/index.ts"],
            "@patcher/*": ["patcher/*"],
            "@plugins/*": ["plugins/*"],
            "@shared/*": ["shared/*"],
            "@utils": ["utils/index.ts"],
            "@utils/*": ["utils/*"],
            "@webpack": ["webpack/index.ts"],
            "@webpack/*": ["webpack/*"],
            "~plugins": ["plugins/index.ts"]
        }
    },
    "include": ["src/**/*", "scripts/**/*", "eslint.config.mjs", "vitest.config.ts"],
    "exclude": ["node_modules", "dist", "scripts/installer"]
}
