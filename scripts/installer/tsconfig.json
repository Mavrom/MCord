{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "strict": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["react", "react-dom", "node"]
    },
    "include": ["src/gui/ui/**/*"]
}
